			"FallBackConfigs": [
				{
					"SNI": "",
					"Alpn": "h2",
					"Path": "",
					"Dest": "82",
					"ProxyProtocolVer": 1
				}
			],
            // 本地限制器相关配置
			"LimitConfig": {
				// 用户速度限制
				"SpeedLimit": 0,
				// 开启动态限速(暂不可用)
				"EnableDynamicSpeedLimit": false,
				// 动态限速相关配置(暂不可用)
				"DynamicSpeedLimitConfig": {
					// 检查周期
					"Periodic": 60,
					// 检查周期内触发限制的流量数
					"Traffic": 1000,
					// 触发限制后的速度限制
